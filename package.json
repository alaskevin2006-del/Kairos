{
  "name": "kairos-personal",
  "version": "1.1.0",
  "private": true,
  "description": "Kairos — 本地 Markdown 的个人时间与目标空间",
  "author": "Kevin",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "desktop": "electron .",
    "test": "node --test test/*.test.mjs",
    "package": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "marked": "^17.0.0"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "space.kevin.kairos",
    "productName": "Kairos",
    "asar": true,
    "afterPack": "scripts/replace-brand-icon.cjs",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "desktop/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Kairos-${version}-Windows.exe",
      "icon": "assets/logo.ico",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
